# MapMate AI Environment Variables

# Required: Your Google Maps API Key
# Get one at: https://developers.google.com/maps/documentation/javascript/get-api-key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Required: A Google API key from a project with the Gemini API enabled
# https://console.cloud.google.com/apis/library/generativelanguage.googleapis.com
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: Server port (default: 8080)
PORT=8080

# Optional: Google ADK Model (default: gemini-3.5-flash-lite)
GOOGLE_ADK_MODEL=gemini-3.5-flash-lite
